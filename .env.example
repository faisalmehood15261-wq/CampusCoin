# Secrets for the API. Never commit the filled-in server/.env.
# On Vercel set these as project environment variables instead of using this file.
PORT=5000
NODE_ENV=development

# Comma-separated CORS allow-list. The first entry is also the origin used to build
# outbound links such as password resets (see publicAppUrl in server/src/config/urls.js).
CLIENT_URL=http://localhost:5173

MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/campuscoin?retryWrites=true&w=majority

JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-another-long-random-string

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

GEMINI_API_KEY=
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Provisioned on boot only when the email is missing; an existing password is never changed.
ADMIN_EMAIL=admin@campuscoin.edu
ADMIN_PASSWORD=change-me-to-a-long-unique-password
